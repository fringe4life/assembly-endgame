{
  "name": "assembly-endgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen && husky",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ultracite:upgrade": "bunx ultracite@latest init --pm bun --linter biome --frameworks react --editors vscode --quiet",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "react": "canary",
    "@rolldown/plugin-babel": "^0.2.2",
    "react-dom": "canary"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.9.1",
    "@biomejs/biome": "2.4.7",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^6.0.2",
    "ultracite": "7.3.2",
    "vite": "^8.0.3"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ],
  "overrides": {
    "@babel/runtime": "^7.26.10",
    "ajv": "^8.18.0",
    "brace-expansion": "^5.0.5",
    "@isaacs/brace-expansion": "^5.0.1",
    "minimatch": "^10.2.1",
    "picomatch": "^2.3.2"
  }
}
